# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=18000
APP_DEBUG=true

# ─── PostgreSQL (non-standard port 15432) ───────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=securedocvault
POSTGRES_USER=sdv
POSTGRES_PASSWORD=sdv_secret_change_me

# ─── Redis (non-standard port 16379) ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_me
REDIS_DB=0

# ─── MinIO (non-standard port 19000 / console 19001) ────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:19000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_change_me
MINIO_BUCKET_DOCUMENTS=securedocvault-docs
MINIO_SECURE=false

# ─── PASETO v4 (replace with 32-byte random secret) ─────────────────────────
PASETO_SECRET_KEY=00000000000000000000000000000000
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secret_change_me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secret_change_me@redis:6379/1

# ─── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=securedocvault-api
OTEL_ENABLED=true

# ─── Security ────────────────────────────────────────────────────────────────
ENABLE_LOG_MASKING=true
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:18000"]

# ─── Document governance ─────────────────────────────────────────────────────
DEFAULT_STORAGE_CLASS=STANDARD
DEFAULT_RETENTION_MODE=GOVERNANCE
AUDIT_CHAIN_ENABLED=true
LEGAL_HOLD_STRICT_MODE=true
MAX_UPLOAD_SIZE_MB=100
